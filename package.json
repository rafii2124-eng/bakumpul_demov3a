{
  "name": "apk-bakumpul",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "main": "main.cjs",
  "scripts": {
    "dev": "vite",
    "server": "tsx server.ts",
    "dev:all": "concurrently -k \"npm run server\" \"npm run dev\"",
    "build": "tsc && vite build",
    "vite:dev": "vite",
    "electron:start": "wait-on http://localhost:5173 && electron .",
    "electron:dev": "concurrently \"npm run vite:dev\" \"npm run electron:start\"",
    "electron:build": "npm run build && electron-builder --win portable"
  
  },
  "build": {
    "appId": "com.apk.bakumpul",
    "productName": "APK Bakumpul",
    "files": [
      "dist/**/*",
      "main.cjs"
    ],
    "win": {
      "target": "portable"
    }
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "chart.js": "^4.5.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^8.2.2",
    "electron": "^28.2.0",
    "electron-builder": "^24.9.0",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vite-plugin-singlefile": "^2.3.3",
    "wait-on": "^7.2.0"
  }
}